{
  "name": "@sleet-js/intear-api-tool-box",
  "version": "0.1.0",
  "description": "Typed TypeScript SDK for the Intear API (https://api.intea.rs) — token data, charts, trades, transfers, balances, holders over HTTP and a single WebSocket connection, with strict per-field types and AsyncIterable subscriptions.",
  "license": "MIT",
  "homepage": "https://sleet-js.near.page",
  "repository": {
    "type": "git",
    "url": "https://github.com/sleet-js/intear-api-tool-box.git"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist/**/*",
    "bin/**/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -f .tsbuildinfo && bun run tsc --build tsconfig.build.json --force",
    "clean": "bun run tsc --build --clean && rm -rf dist .tsbuildinfo"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "//": "compatible with bun + tsc --build; emit ESM to dist/, publish dist + bin + README + LICENSE."
}
